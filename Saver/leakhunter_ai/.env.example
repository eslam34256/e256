# Demo deployment (synthetic data only)
LEAKHUNTER_DEMO_MODE=1
LEAKHUNTER_DEMO_PASSWORD=change-this-to-a-long-random-password
LEAKHUNTER_DATA_DIR=/data
LEAKHUNTER_DB_PATH=/data/leakhunter.db

# For a fresh pilot deployment, set DEMO_MODE=0 and uncomment these once.
# Remove LEAKHUNTER_BOOTSTRAP_PASSWORD after the first successful startup.
# LEAKHUNTER_ORG_NAME=Acme Procurement
# LEAKHUNTER_ORG_SECTOR=Manufacturing
# LEAKHUNTER_ORG_CURRENCY=EGP
# LEAKHUNTER_ADMIN_EMAIL=admin@example.com
# LEAKHUNTER_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
